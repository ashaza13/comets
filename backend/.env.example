# Anthropic API key (read by the Anthropic SDK)
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low            # low | medium | high
# LLM_MAX_TOKENS=4096
# CORS_ORIGINS=["https://your-frontend.example"]

# Constellations (compare with friends). Set by Vercel's Upstash integration;
# without them sharing is off.
# KV_REST_API_URL=https://....upstash.io
# KV_REST_API_TOKEN=...
# Local development only: keep constellations in memory (lost on restart).
# GROUPS_IN_MEMORY=true
