# ── Local Ollama (default) ─────────────────────────────────────────────────────
LLM_MODEL=ollama_chat/llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# ── Swap to cloud by changing LLM_MODEL and adding the relevant API key ────────

# Anthropic Claude (add your key, change model):
# LLM_MODEL=anthropic/claude-3-5-haiku-20241022
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (add your key, change model):
# LLM_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=sk-...

# ── Tuning ─────────────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
